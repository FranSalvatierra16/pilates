# Copiá este archivo a .env y reemplazá con tus valores.
# .env no se sube a git (está en .gitignore).

# URL de PostgreSQL (Railway → tu proyecto → PostgreSQL → Variables → DATABASE_URL)
DATABASE_URL=postgresql://usuario:password@host:puerto/railway

# WhatsApp (GREEN-API) — avisos al profe cuando liberan / se anotan vía chatbot
# GREEN_API_URL=https://api.green-api.com
# GREEN_API_ID_INSTANCE=xxxx
# GREEN_API_TOKEN_INSTANCE=xxxx
# Celular del profe (con código de país). Default en código: 5492235029881
# CHATBOT_AVISO_WHATSAPP=5492235029881

# Frontend (Vite): solo sitio público de marketing, sin rutas de login ni app.
# En Railway agregá en el servicio del *build* del frontend: VITE_PUBLIC_SITE_MODE=landing
# Valores: vacío o "full" = app completa; "landing" o "marketing" = solo la landing en / y el resto redirige a /.
# VITE_PUBLIC_SITE_MODE=landing
